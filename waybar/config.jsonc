{
    // ── Bar settings ──────────────────────────────────────────────────────────
    "layer": "top",
    "margin-top": 14,
    "margin-bottom": 0,
    "margin-left": 0,
    "margin-right": 0,
    "spacing": 0,

    "output": [
        "eDP-1"
    ],

    // ── Layout ────────────────────────────────────────────────────────────────
    "modules-left": [
        "tray",
        "hyprland/window"
    ],

    "modules-center": [
        "hyprland/workspaces"
    ],

    "modules-right": [
        // "custom/updates",
        "pulseaudio",
        "bluetooth",
        "battery",
        "network",
        "group/hardware",
        "custom/exit",
        "clock"
    ],

    // System tray
    "tray": {
        "icon-size": 21,
        "spacing": 10
    },

    // Hyprland Window
    "hyprland/window": {
        "rewrite": {
            "(.*) - Brave": "$1",
            "(.*) - Chromium": "$1",
            "(.*) - Brave Search": "$1",
            "(.*) - Outlook": "$1",
            "(.*) Microsoft Teams": "$1"
        },
        "separate-outputs": true
    },

    // Workspaces
    //
    // Hyprland 0.55 replaced hyprlang with lua, and `hyprctl dispatch` now
    // takes a lua expression instead of a dispatcher name + positional args.
    // The old `hyprctl dispatch workspace r-1` form is a lua PARSE error now:
    //   error: [string "return hl.dispatch(workspace r-1)"]:1: ')' expected
    // Hence the lua form in on-scroll-* below.
    //
    // KNOWN BROKEN: "on-click": "activate" does nothing on waybar 0.15.0.
    // `activate` is not a shell command -- it's an undocumented special value
    // handled inside waybar, which writes the pre-0.55 string straight to the
    // Hyprland IPC socket (see `strings $(which waybar) | grep dispatch`), so
    // it can't be fixed from this file. `move-to-monitor: true` is broken for
    // the same reason (it emits `focusworkspaceoncurrentmonitor`).
    // Fixed upstream by Alexays/Waybar PR #5013 (merged 2026-05-04) and #5231
    // (2026-08-27), both landing AFTER the 0.15.0 release (2026-02-06); see
    // issue #5198. Arch `extra` still ships 0.15.0.
    // => Upgrading to waybar >= 0.16.0 (or waybar-git) should fix clicking with
    //    NO change to this file: #5231 detects the compositor's config
    //    language at runtime. The on-scroll-* lines below are plain shell
    //    commands, so they keep working with a patched build too.
    // Workarounds until then: scroll on this module, or SUPER + 1..0.
    "hyprland/workspaces" : {
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"r-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"r+1\" })'",
        "on-click": "activate",
        "active-only": false,
        "all-outputs": true,
        "format": "{}",
        "format-icons": {
            "urgent": "",
            "active": "",
            "default": ""
        }
    },

    // Pulseaudio
    "pulseaudio": {
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
        "format": "{icon}   {volume}% {format_source} ",
        "format-bluetooth": "{volume}%  {icon} {format_source}",
        "format-bluetooth-muted": " {icon} {format_source}",
        "format-muted": " {format_source} ",
        "format-source": " {volume}%",
        "format-source-muted": "",
        "format-icons": {
            "headphone": " ",
            "hands-free": " ",
            "headset": " ",
            "phone": " ",
            "portable": " ",
            "car": " ",
            "default": [" ", " ", " "]
        },
        "on-click-middle": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click": "pavucontrol"
    },

    // Bluetooth
    "bluetooth": {
        "format": " {status}",
        "format-disabled": "",
        "format-off": "",
        "interval": 30,
        "on-click": "blueman-manager",
        "format-no-controller": ""
    },

    // Battery
    //
    // CRASH FIX: without "bat", this module watches every directory under
    // /sys/class/power_supply/, which includes hidpp_battery_N -- the battery
    // of the Bluetooth MX Master 3S. That node appears and disappears each time
    // the mouse (re)connects, and waybar loses the race: its udev worker thread
    // sees the new directory, calls inotify_add_watch() on <dir>/uevent, gets
    // ENOENT because the device is already gone, and throws std::runtime_error
    // ("Could not watch events for ...") from a thread with no catch handler
    // => std::terminate => SIGABRT, whole bar gone. Naming the battery makes
    // refreshBatteries() skip hidpp nodes before it ever adds the watch.
    // Verified in waybar 0.15.0-3: the "bat" check is at +0xd04dd, the
    // inotify_add_watch at +0xd0a34.
    "battery": {
        "bat": "BAT1",
        "states": {
            // "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}   {capacity}%",
        "format-charging": "  {capacity}%",
        "format-plugged": "  {capacity}%",
        "format-alt": "{icon}  {time}",
        // "format-good": "", // An empty format will hide the module
        // "format-full": "",
        "format-icons": [" ", " ", " ", " ", " "]
    },

    // Network
    "network": {
        "format": "{ifname}",
        "format-wifi": "   {signalStrength}%",
        "format-ethernet": "  {ifname}",
        "format-disconnected": "Disconnected",
        "tooltip-format": " {ifname} via {gwaddri}",
        "tooltip-format-wifi": "  {ifname} @ {essid}\nIP: {ipaddr}\nStrength: {signalStrength}%\nFreq: {frequency}MHz\nUp: {bandwidthUpBits} Down: {bandwidthDownBits}",
        "tooltip-format-ethernet": " {ifname}\nIP: {ipaddr}\n up: {bandwidthUpBits} down: {bandwidthDownBits}",
        "tooltip-format-disconnected": "Disconnected",
        "max-length": 50,
        "on-click": "$(cat ~/dotfiles/.settings/terminal.sh) --class dotfiles-floating -e nmtui",
        "on-click-right": "~/dotfiles/.settings/networkmanager.sh"
    },

    // Group Hardware
    "group/hardware": {
        "orientation": "inherit",
        // "drawer": {
        //     "transition-duration": 300,
        //     "children-class": "not-memory",
        //     "transition-left-to-right": false
        // },        
        "modules": [
            "disk",
            "cpu",
            "memory"
            // ,"custom/system"
            // "hyprland/language"
        ]
    },

    // CPU
    "cpu": {
        "format": "/ C {usage}% "
    },

    // Memory
    "memory": {
        "format": "/ M {}% "
    },

    // Harddisc space used
    "disk": {
        "interval": 30,
        "format": "D {percentage_used}% ",
        "path": "/"
    }, 

    // Power Menu
    "custom/exit": {
        "format": "",
        "on-click": "wlogout",
        "tooltip-format": "Power Menu"
    },

    // Clock
    "clock": {
        "format": "{:%H:%M - %a %Od}",
        "timezone": "Europe/Copenhagen",
        // "timezone": "America/New_York",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        // START CLOCK FORMAT
        "format-alt": "{:%Y-%m-%d}"
        // END CLOCK FORMAT
    }

    // // Updates Count
    // "custom/updates": {
    //     "format": "   {}",
    //     "escape": true,
    //     "return-type": "json",
    //     "exec": "~/dotfiles/scripts/updates.sh",
    //     "restart-interval": 60,
    //     "on-click": "$(cat ~/dotfiles/.settings/terminal.sh) --class dotfiles-floating -e ~/dotfiles/scripts/installupdates.sh",
    //     "on-click-right": "~/dotfiles/.settings/software.sh"
    // },    
}
